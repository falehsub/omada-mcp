{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/falehsub/omada-mcp/blob/main/schemas/doctor.schema.json",
  "title": "omada-mcp --doctor --json output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "platform",
    "status",
    "ready",
    "exitCode",
    "controller",
    "site",
    "summary",
    "phases"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "ready": { "type": "boolean" },
    "exitCode": { "type": "integer", "enum": [0, 1] },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omadacId", "controllerVer", "family", "sessionCookie"],
      "properties": {
        "omadacId": { "type": ["string", "null"] },
        "controllerVer": { "type": ["string", "null"] },
        "family": { "type": ["string", "null"] },
        "sessionCookie": { "type": ["string", "null"] }
      }
    },
    "site": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "name", "index", "total", "requested"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "requested": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "warned", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "warned": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "detail", "hint"],
        "properties": {
          "name": { "type": "string", "enum": ["env", "tls", "login", "site", "tools", "write"] },
          "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
          "detail": { "type": "string" },
          "hint": { "type": ["string", "null"] }
        }
      }
    }
  }
}
