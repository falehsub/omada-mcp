# omada-mcp configuration -- copy to .env (chmod 600) or to
# ~/.config/omada-mcp/.env (POSIX) / %APPDATA%\omada-mcp\.env (Windows),
# then run `omada-mcp --doctor`.
#
# Resolution order: process environment > $OMADA_ENV_FILE > ./.env
#                  > %APPDATA%\omada-mcp\.env (Windows)
#                  > ~/.config/omada-mcp/.env

# --- required ----------------------------------------------------------
# Controller web UI URL. The port is 8043 for https (default) and 8088 for
# http. A scheme-less value is treated as https and gets :8043.
OMADA_BASE_URL=https://192.0.2.10:8043

# A *local* controller account (Viewer is enough for the read-only tools).
OMADA_USERNAME=omada-readonly
OMADA_PASSWORD=change-me

# --- site selection (optional) ----------------------------------------
# Omit both to use the first site the account can see.
# OMADA_SITE_NAME=Home
# OMADA_SITE_ID=0123456789abcdef01234567

# --- TLS (optional but recommended) -----------------------------------
# PEM bundle with the controller's CA. Self-signed controllers: export the
# certificate from the controller UI (Settings > Controller > Certificate).
# OMADA_CA_BUNDLE=~/.config/omada-mcp/controller-ca.pem

# true (default) = verify the chain and hostname.
# false = no verification; only for a first connection to a self-signed
#         controller on a trusted network.
OMADA_VERIFY_SSL=true

# Python 3.13+ enables VERIFY_X509_STRICT by default, which rejects some
# otherwise-working controller certificates (self-signed, missing CA bit,
# v1 certs). false keeps chain + hostname checks but drops that flag.
OMADA_STRICT_X509=true

# Optional TLS hostname override for certificate SAN verification when connecting
# by IP against Omada's built-in cert (whose SAN is typically DNS:Omada).
# OMADA_TLS_SERVER_NAME=Omada

# --- safety ------------------------------------------------------------
# true = refuse every tool that is not declared read-only (v1.0 shipped only
# read-only tools; the switch guarantees write tools stay fail-closed).
OMADA_READ_ONLY=false

# Write tools stay disabled and hidden until EXPLICITLY allowlisted here.
# Use a dedicated Admin local account (separate from any read-only bridge or web UI
# session, because each login evicts the previous session sharing the same username).
# Valid names (31 tools):
#   set_client_fixed_ip, release_client_fixed_ip, set_vlan_dhcp_pools,
#   set_vlan_isolation, create_ip_group, replace_ip_group, delete_ip_group,
#   create_gateway_acl, update_gateway_acl, set_acl_rule_status, delete_gateway_acl,
#   upsert_dhcp_reservation, delete_dhcp_reservation, create_lan_network,
#   update_lan_network, delete_lan_network, create_ssid, update_ssid, delete_ssid,
#   upsert_port_forward, delete_port_forward, upsert_static_route,
#   delete_static_route, upsert_mdns_rule, delete_mdns_rule, set_upnp,
#   set_client_blocked, reconnect_client, update_client, update_device,
#   reboot_device
# OMADA_WRITE_TOOLS=
# OMADA_SNAPSHOT_DIR=
# OMADA_MANAGEMENT_CIDRS=

# --- networking (optional) ---------------------------------------------
# false (default) = never use a system/registry proxy for controller calls.
# On Windows, urllib inherits the WinINET proxy settings, which makes a
# one-hop controller look unreachable. Set true only if a proxy is required.
OMADA_USE_SYSTEM_PROXY=false

# --- tuning (optional) -------------------------------------------------
# OMADA_TIMEOUT_SECONDS=30
# Delay between controller calls. 0.8 is the safe value for large sites;
# the defaults (0.25) plus an automatic 0.8 s retry on errorCode -1600.
# OMADA_MIN_INTERVAL_SECONDS=0.25
# Minimum spacing between write calls (seconds, default 1.0). Never auto-retries writes.
# OMADA_WRITE_INTERVAL_SECONDS=1.0
